{
  "name": "digital_literacy",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./index.html --outdir=./dist && bunx cap sync",
    "apk": ". ./.android_env && bunx cap build android  --androidreleasetype APK --keystorepath $KEYSTORE --keystorepass bsdpLGfkMpP5JLxjn86w --keystorealias release --keystorealiaspass bsdpLGfkMpP5JLxjn86w && cp ./android/app/build/outputs/apk/release/*-signed.apk ./build/",
    "android": ". ./.android_env && bunx cap run android",
    "ios": "bunx cap run ios",
    "dev": "bun --hot server.ts",
    "start": "bun server.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}